APP_NAME=Gitcoin Bounty Tracker API
APP_VERSION=2.0.0
DEBUG=true

# Local SQLite:
DATABASE_URL=sqlite:///./bounties.db

# Docker/PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/gitcoin_bounties

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
